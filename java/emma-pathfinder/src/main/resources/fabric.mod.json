{
  "schemaVersion": 1,
  "id": "emma-bridge",
  "version": "${version}",

  "name": "Emma Bridge",
  "description": "Emma AI co-host Minecraft bridge — WebSocket API, GOAP agent, and Emmatone pathfinding",
  "authors": [
    "Elric"
  ],

  "license": "LGPL-3.0",

  "environment": "client",
  "entrypoints": {
    "main": ["com.emma.bridge.EmmaBridgeMod"],
    "client": ["com.emma.bridge.EmmaBridgeClient"]
  },
  "accessWidener": "emma-pathfinder.accesswidener",
  "mixins": [
    "emma-bridge.mixins.json",
    "mixins.emmatone.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
